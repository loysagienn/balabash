{
  "manifest_version": 3,
  "name": "Balabash Agent",
  "version": "0.7.1",
  "description": "Connects this browser to your Balabash server so that its agent can see the tabs, open pages and act in them.",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Balabash Agent",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": ""
}
