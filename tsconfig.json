{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "lib": ["ESNext"],
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src/**/*", "agents/**/*", "tools/**/*", "tasks/**/*", "scripts/**/*", "prisma-generated/**/*", "prisma.config.ts"],
  // src/web is the Next.js client app: its own sub-project with its own
  // tsconfig (DOM libs, jsx) — the core typecheck must not touch it.
  "exclude": ["node_modules", "src/web"]
}
