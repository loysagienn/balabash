# Connection string of the Postgres database (the live one is named
# balabash_v2 for historical reasons).
DATABASE_URL="postgresql://user:password@host:25060/balabash_v2?sslmode=require"

# Channels are optional adapters: each is
# switched on by its own variables; the core and the agents do not know which
# channels are up.

# Telegram — on when the bot token is set. Logins in TELEGRAM_ALLOWED_LOGINS
# may activate a workspace with /start in a group (a group is a workspace);
# after activation, group membership is the trust boundary. Without the
# allowlist no new group can be activated, the activated ones keep working.
TELEGRAM_BOT_TOKEN="bot_token"
TELEGRAM_ALLOWED_LOGINS="username1,username2"

# Claude remote-control (CCR) — the "remote sessions" of the operator's Claude
# app as the surface of claude-sdk agent threads (engineer, architect, …):
# each such thread becomes a cse_* session mirroring the agent's live stream;
# the Stop button is a soft stop of the turn. Authenticated by the ambient
# Claude CLI login of the box (~/.claude/.credentials.json, read-only; or
# CLAUDE_CODE_OAUTH_TOKEN). Serves exactly the operator's workspace.
CCR_ENABLED="false"
# CCR_BASE_URL="https://api.anthropic.com"
# CCR_FILES_BASE_URL="https://api.anthropic.com/api/oauth/files"

# The operator's workspace for singleton channels and offline scripts (§3.1):
# needed only when the workspaces table holds several workspaces; with zero or
# one workspace it is resolved automatically (a missing workspace is created).
# OPERATOR_WORKSPACE_ID="uuid"

OPENAI_API_KEY="api_key"
# The coordinator's LLM backend: "openai" (api.openai.com — stateful turns,
# explicit prompt cache with keep-alive pings), "openai-compatible" (any
# Responses API server without server-side state, e.g. LiteLLM/vLLM at
# OPENAI_BASE_URL — the whole input every iteration, the server's own
# automatic prefix cache, no pings) or "anthropic" (api.anthropic.com over
# the Messages API with MAIN_ANTHROPIC_API_KEY and MAIN_ANTHROPIC_MODEL —
# 1-hour prompt cache with keep-alive pings). Default "openai".
# LLM_BACKEND="anthropic"
# OPENAI_BASE_URL="https://llm-gateway.example.com/v1"
# Never set ANTHROPIC_API_KEY itself here: the Claude Agent SDK sessions the
# app starts inherit its environment and would bill that key instead of
# running on the host's Claude plan login.
# MAIN_ANTHROPIC_API_KEY="sk-ant-..."
# Reasoning effort of the coordinator model on backends that take one
# (anthropic): low | medium | high | xhigh | max. Default "medium".
# COORDINATOR_EFFORT="medium"
# The coordinator model of each backend; the configured backend's one is read.
MAIN_OPENAI_MODEL="gpt-6.1-sol"
# MAIN_ANTHROPIC_MODEL="claude-opus-5-5"
# The workspace annotation indexer (titles/descriptions of workspace files,
# a cheap model on a 15-minute timer). Default on; "false" switches it off.
# INDEXER_ENABLED="false"
# INDEXER_OPENAI_MODEL="gpt-5.6-luna"
# The coordinator's transcript budget in chars (the rendered event log of a
# turn); default 50000, ~12k tokens.
# COORDINATOR_TRANSCRIPT_CHARS="50000"
# Minutes after the coordinator's last turn during which its prompt-cache
# prefix is kept warm with prewarm pings (OpenAI's cache TTL is 30 minutes,
# a ping costs ~1/12 of a cold rewrite). 0 disables. Default 360.
COORDINATOR_CACHE_KEEPALIVE_MINUTES="360"

# File storage driver: "spaces" (S3-compatible object store, presigned
# download URLs) or "local" (the local disk under FILES_ROOT — files/ in the
# repository root by default — with signed download links on the web
# surface, https://<CONSOLE_DOMAIN>/files/dl/<fileId>?exp=…&sig=…). Unset:
# spaces when SPACES_* are set, local otherwise. A row is always read by the
# driver that wrote it, so switching keeps old files readable.
# FILE_STORAGE="local"
# FILES_ROOT="files"

# Spaces (S3-compatible) object storage for files; the endpoint host is
# derived from the region (<region>.digitaloceanspaces.com).
SPACES_REGION="ams3"
SPACES_BUCKET_NAME="bucket"
SPACES_ACCESS_KEY_ID="key_id"
SPACES_ACCESS_KEY_SECRET="key_secret"

# The web surface (§11.4): the console — a browser SPA served by the core
# itself (src/console, src/api/console.ts) — and, under the same host, the
# shared surfaces /api, /files, /connect, /oauth/callback and /apps/<path>.
# CONSOLE_DOMAIN (required) is the public host behind the TLS-terminating
# reverse proxy: every link the system hands out — the one-time provisioning
# and sign-in links, the bot's /login, the owner pages of apps, the signed
# file links — and the single OAuth redirect URI
# (https://<CONSOLE_DOMAIN>/oauth/callback, to register with Google/Yandex
# and any other OAuth client) are built from it; the core serves requests
# only for this host (and APPS_DOMAIN below). HTTP_PORT is the core's Koa on
# loopback — the only listener: the proxy sends the whole console host to it
# with Host and X-Forwarded-Proto preserved (no path routing at the edge).
# The SPA is built by `npm run build-console` into dist/console (part of
# `npm run build`); a new build is live with the next page load, no restart;
# without a build the host answers 503. SESSION_PEPPER: a random secret (e.g.
# `openssl rand -hex 32`) under the session cookie hashes and the signed file
# links; changing it logs every browser out.
CONSOLE_DOMAIN="console.balabash.example.com"
HTTP_PORT="3000"
SESSION_PEPPER="change-me"
# Apps (src/apps): with APPS_DOMAIN the apps run on their own host (the proxy
# sends it to HTTP_PORT too): owner pages https://<CONSOLE_DOMAIN>/apps/<path>
# are handed off to it under the apps cookie — APPS_COOKIE_SECRET required —
# and published apps live at https://<APPS_DOMAIN>/<slug>; unset, the apps run
# on the console domain itself: /apps/<path> behind the web session, published
# apps at https://<CONSOLE_DOMAIN>/a/<slug> without login.
# APPS_DOMAIN="balabash.app"
# APPS_COOKIE_SECRET="change-me-too"

# Browser agent (agents/browser.ts). With DISPLAY set, Chromium runs headful
# on that X display (the host's Xvfb) so the user can watch and intervene —
# login, CAPTCHA — through noVNC; unset, the browser runs headless and the
# agent cannot hand manual steps to the user. Install the browser once with:
# npx playwright install chromium
DISPLAY=":99"
# HTTP proxy for all browser-agent traffic (Playwright `proxy.server`). On the
# host this is Privoxy, a pure router: `.ru` domains go into the Moscow SOCKS
# tunnel (moscow-socks.service, 127.0.0.1:1080), everything else directly.
# Unset — the browser connects directly.
BROWSER_PROXY_SERVER="http://127.0.0.1:8118"
