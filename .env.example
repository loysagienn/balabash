# Connection string of the balabash_v2 database (separate from v1's balabash).
DATABASE_URL="postgresql://user:password@host:25060/balabash_v2?sslmode=require"

# The v2 bot (separate from v1's). Logins in TELEGRAM_ALLOWED_LOGINS may
# activate a workspace with /start in a group; after activation, group
# membership is the trust boundary.
TELEGRAM_BOT_TOKEN="bot_token"
TELEGRAM_ALLOWED_LOGINS="username1,username2"

OPENAI_API_KEY="api_key"
# The coordinator model.
MAIN_OPENAI_MODEL="gpt-5.6-terra"

# Spaces (S3-compatible) object storage for files; the endpoint host is
# derived from the region (<region>.digitaloceanspaces.com).
SPACES_REGION="ams3"
SPACES_BUCKET_NAME="bucket"
SPACES_ACCESS_KEY_ID="key_id"
SPACES_ACCESS_KEY_SECRET="key_secret"

# The web surface (§11.4): provisioning forms and the OAuth callback. DOMAIN
# is the public host behind the TLS-terminating proxy — one-time links and
# the OAuth redirect URI (https://<DOMAIN>/oauth/callback) are built from it.
DOMAIN="balabash.example.com"
HTTP_PORT="3000"
